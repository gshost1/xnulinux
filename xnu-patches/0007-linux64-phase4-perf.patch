+ * possible). ml_timebase_scale_update() after every change of ml_timebase_scale_num/den (pe_identify_machine.c).
+ */
+struct linux64_tb_scale linux64_tb = { .num = 1, .den = 1, .magic = 0, .shift = 0, .scaled = 0 };
+_Static_assert(__builtin_offsetof(struct linux64_tb_scale, magic) == 16 && __builtin_offsetof(struct linux64_tb_scale, shift) == 24 &&
