+void
+ml_timebase_scale_update(void)
+{
+	const uint64_t num = ml_timebase_scale_num, den = ml_timebase_scale_den;
+
+	linux64_tb.scaled = 0;
+	linux64_tb.num = num;
+	linux64_tb.den = den;
+	if (num == den) {
+		return;
+	}
+	if (den < 2) {
+		linux64_tb.scaled = 2;
+		return;
+	}
+	const unsigned l = 64 - (unsigned)__builtin_clzll(den - 1);	/* ceil(log2(den)): 1..32 */
+	linux64_tb.magic = (uint64_t)((((unsigned __int128)((1ULL << l) - den)) << 64) / den) + 1;
+	linux64_tb.shift = l - 1;
+	linux64_tb.scaled = 1;
